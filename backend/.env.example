# 複製為 .env 後依環境調整；正式環境請改用強密碼與隨機字串，勿提交真實值。

# Prisma 資料庫連線字串。開發階段使用 SQLite 檔案，
# 未來升級 MySQL/PostgreSQL 時僅需改成對應的連線字串，例如：
# mysql://user:password@localhost:3306/idv_web
# postgresql://user:password@localhost:5432/idv_web
DATABASE_URL="file:./dev.db"

# 後端服務埠號
PORT=3001

# 前端網址（CORS 允許來源）
FRONTEND_ORIGIN="http://localhost:5173"

# 單一管理者帳號
ADMIN_EMAIL="admin@example.com"
# 使用 bcrypt 雜湊後的密碼，請勿填明碼；可用 backend 的雜湊小工具產生
ADMIN_PASSWORD_HASH="$2a$10$replace-with-a-real-bcrypt-hash"

# JWT 簽章密鑰，請於正式環境改為隨機長字串
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="12h"

# 頭像上傳限制
UPLOAD_MAX_SIZE_MB=5
