generator client {
  provider        = "prisma-client-js"
  // D1 需要 driver adapters；Prisma 5.12+ 起支援 D1，本專案的 5.21.1 已滿足，
  // 因此不需要升級 Prisma 主版本。詳見 docs/D1.md。
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 單筆個人資料（姓名、稱呼、簡介、頭像路徑、聯絡方式）
model Profile {
  id            Int      @id @default(autoincrement())
  displayName   String
  preferredName String
  titleZh       String
  titleEn       String
  introZh       String
  introEn       String
  avatarUrl     String?
  contactEmail  String?
  // 聯絡連結（如 GitHub、LinkedIn），以 JSON 字串儲存（SQLite 不支援 Json 型別），格式為 [{ "label": string, "url": string }]
  contactLinks  String?
  updatedAt     DateTime @updatedAt
}

// 技能分類（如「後端開發」「API」...）
model SkillCategory {
  id        Int     @id @default(autoincrement())
  nameZh    String
  nameEn    String
  sortOrder Int     @default(0)
  skills    Skill[]
}

// 分類底下的技能項目
model Skill {
  id         Int           @id @default(autoincrement())
  nameZh     String
  nameEn     String
  sortOrder  Int           @default(0)
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int
}

// 工作經歷（含任職期間、摘要與重點條列）
model Experience {
  id           Int       @id @default(autoincrement())
  companyZh    String
  companyEn    String
  roleZh       String
  roleEn       String
  locationZh   String?
  locationEn   String?
  startDate    DateTime
  endDate      DateTime?
  summaryZh    String
  summaryEn    String
  // 重點條列，以 JSON 字串儲存（SQLite 不支援 Json 型別），格式為 string[]
  highlightsZh String
  highlightsEn String
  sortOrder    Int       @default(0)
}

// 專案作品
model Project {
  id           Int      @id @default(autoincrement())
  nameZh       String
  nameEn       String
  // 分類（如「SaaS」「Portfolio」），現階段選填，供首頁分組與篩選使用
  categoryZh   String?
  categoryEn   String?
  // 副標題，現階段選填
  subtitleZh   String?
  subtitleEn   String?
  summaryZh    String
  summaryEn    String
  // 重點條列，以 JSON 字串儲存（SQLite 不支援 Json 型別），格式為 string[]
  highlightsZh String
  highlightsEn String
  // 技術標籤，以 JSON 字串儲存，格式為 string[]
  techStack    String?
  // 既有欄位語意保留為 live/project URL（部署後的可瀏覽網址）
  link         String?
  githubUrl    String?
  imageUrl     String?
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
}

// 工程案例研究（Engineering Case Study）
model EngineeringCase {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  titleZh          String
  titleEn          String
  categoryZh       String
  categoryEn       String
  summaryZh        String
  summaryEn        String
  problemZh        String
  problemEn        String
  contextZh        String
  contextEn        String
  investigationZh  String
  investigationEn  String
  solutionZh       String
  solutionEn       String
  validationZh     String
  validationEn     String
  resultZh         String
  resultEn         String
  // 架構流程步驟，以 JSON 字串儲存，格式為 { labelZh: string; labelEn: string }[]，供 ArchitectureFlow 元件使用
  architecture     String?
  // 技術標籤，以 JSON 字串儲存，格式為 string[]
  techStack        String?
  githubUrl        String?
  projectUrl       String?
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 專業認證（如 ISO 27001 主導稽核員）
model Certification {
  id            Int       @id @default(autoincrement())
  nameZh        String
  nameEn        String
  issuerZh      String
  issuerEn      String
  descriptionZh String?
  descriptionEn String?
  credential    String?
  issuedAt      DateTime?
  link          String?
  sortOrder     Int       @default(0)
}

// 單一管理者帳號
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
